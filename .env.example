# Copia este archivo a .env y rellena tus valores reales.
# En GitHub: Settings → Secrets and variables → Actions → New repository secret
# (los mismos nombres; el workflow los usa en el build de Pages).

# Número con código de país, sin + ni espacios (ej. México: 5215512345678)
VITE_WHATSAPP_NUMBER=

# URL del Web App de Google Apps Script (ver google-apps-script/Code.gs)
VITE_SHEETS_WEBAPP_URL=

# Opcional: link de pago de Mercado Pago
VITE_MERCADOPAGO_LINK=
